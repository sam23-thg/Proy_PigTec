*~

# Dependencias y cachés del frontend
node_modules/
.npm/
.cache/
.vite/
dist/
build/
coverage/

# Dependencias PHP instaladas localmente y ejecutables descargados
/vendor/
composer.phar

# Cachés generadas por herramientas de análisis y formato de PHP
.phpunit.result.cache
.php-cs-fixer.cache

# Temporales y registros de servidores locales
*.log
logs/
tmp/
temp/
.phpunit.cache/
php_errorlog
error_log
*.pid

# Archivos de entorno y credenciales
.env
.env.*
!.env.example
!.env.example.*

# Archivos de respaldo y temporales comunes
*.old
*.orig
*.save

# Base de datos local con archivos generados o específicos del entorno
/database/

# Documentación ajena a los sprints mantenida fuera del repositorio
/docs/*
!/docs/sprint1/
!/docs/sprint2/

# Archivos de documentación del Sprint 1 que deben aparecer en Git
/docs/sprint1/*
!/docs/sprint1/architecture_context.md
!/docs/sprint1/requirements.md
!/docs/sprint1/tasks.md
!/docs/sprint1/ui_design_guide.md

# Archivos de documentación del Sprint 2 que deben aparecer en Git
/docs/sprint2/*
!/docs/sprint2/architecture_context.md
!/docs/sprint2/requirements.md
!/docs/sprint2/tasks.md
!/docs/sprint2/ui_design_guide.md

